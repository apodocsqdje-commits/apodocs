generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Faculty {
  id          String       @id @default(uuid())
  name        String
  acronym     String
  departments Department[]

  @@index([acronym])
}

model Department {
  id        String    @id @default(uuid())
  name      String
  facultyId String
  faculty   Faculty   @relation(fields: [facultyId], references: [id])
  subjects  Subject[]

  @@index([facultyId])
}

model Subject {
  id           String     @id @default(uuid())
  name         String
  semester     Int
  departmentId String
  documents    Document[]
  department   Department @relation(fields: [departmentId], references: [id])

  @@index([departmentId])
  @@index([semester])
}

model Document {
  id            String    @id @default(uuid())
  title         String
  type          DocType
  fileUrl       String
  status        DocStatus @default(PENDING)
  subjectId     String
  createdAt     DateTime
  likes         Int       @default(0)
  fileHash      String?
  realName      String
  authorName    String?
  uploaderToken String?
  subject       Subject   @relation(fields: [subjectId], references: [id])

  @@index([status, createdAt(sort: Desc)])
  @@index([status, type])
  @@index([status, subjectId])
  @@index([subjectId])
  @@index([type])
  @@index([likes(sort: Desc)])
  @@index([uploaderToken])
}

model Admin {
  id        String   @id @default(cuid())
  username  String   @unique
  password  String
  role      String   @default("MODERATOR")
  createdAt DateTime @default(now())
}

enum DocType {
  COURSE
  EXAM
  TD_TP
  SUMMARY
}

enum DocStatus {
  PENDING
  APPROVED
  REJECTED
}
